package com.example.gamecasino.controller;
import com.example.gamecasino.model.Player;
import com.example.gamecasino.repository.PlayerRepository;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
@Controller
public class CasinoController {
    private final PlayerRepository playerRepository;
    public CasinoController(PlayerRepository playerRepository) {
        this.playerRepository = playerRepository;
    }
    // トップページ
    @GetMapping("/")
    public String home(Model model) {
        model.addAttribute("title", "Game Casino");
        return "index";
    }
    // プレイヤー登録画面
    @GetMapping("/player")
    public String playerPage() {
        return "player";
    }
    // プレイヤー登録処理
    @PostMapping("/player/start")
    public String startGame(
            @RequestParam String playerName,
            Model model) {
        // 名前の入力チェック
        if (playerName == null || playerName.trim().isEmpty()) {
            model.addAttribute("error", "プレイヤー名を入力してください。");
            return "player";
        }
        Player player = new Player(playerName.trim());
        // H2データベースに保存
        playerRepository.save(player);
        model.addAttribute("player", player);
        return "home";
    }
}
 
package com.example.gamecasino.controller;
import com.example.gamecasino.model.Player;
import com.example.gamecasino.repository.PlayerRepository;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
import java.util.Random;
@Controller
public class SlotController {
    private final PlayerRepository playerRepository;
    private final Random random = new Random();
    public SlotController(PlayerRepository playerRepository) {
        this.playerRepository = playerRepository;
    }
    // スロット画面
    @GetMapping("/slot")
    public String slot(Model model) {
        Player player = playerRepository.findAll()
                .stream()
                .findFirst()
                .orElse(null);
        model.addAttribute("player", player);
        return "slot";
    }
    // スロットを回す
    @PostMapping("/slot/play")
    public String playSlot(
            @RequestParam int bet,
            Model model) {
        Player player = playerRepository.findAll()
                .stream()
                .findFirst()
                .orElse(null);
        // プレイヤーがいない場合
        if (player == null) {
            model.addAttribute("error",
                    "プレイヤーが登録されていません。先に登録してください。");
            return "slot";
        }
        // 掛け金チェック
        if (bet <= 0) {
            model.addAttribute("error",
                    "掛け金は1以上にしてください。");
            model.addAttribute("player", player);
            return "slot";
        }
        // 掛け金を支払う
        if (player.getCoin() >= bet) {
            player.setCoin(player.getCoin() - bet);
        } else {
            // コインが足りない分は借金にする
            int shortage = bet - player.getCoin();
            player.setCoin(0);
            player.setDebt(player.getDebt() + shortage);
        }
        // スロットの絵柄
        String[] symbols = {"🍒", "🍋", "🍊", "BAR", "7"};
        String s1 = symbols[random.nextInt(symbols.length)];
        String s2 = symbols[random.nextInt(symbols.length)];
        String s3 = symbols[random.nextInt(symbols.length)];
        int multiplier = 0;
        // 当たり判定
        if (s1.equals("7")
                && s2.equals("7")
                && s3.equals("7")) {
            multiplier = 50;
        } else if (s1.equals("BAR")
                && s2.equals("BAR")
                && s3.equals("BAR")) {
            multiplier = 20;
        } else if (s1.equals("🍒")
                && s2.equals("🍒")
                && s3.equals("🍒")) {
            multiplier = 10;
        } else if (s1.equals(s2) && s2.equals(s3)) {
            multiplier = 5;
        }
        // 払い戻し
        int payout = bet * multiplier;
        player.setCoin(player.getCoin() + payout);
        // H2データベースに保存
        playerRepository.save(player);
        // 画面に結果を渡す
        model.addAttribute("player", player);
        model.addAttribute("s1", s1);
        model.addAttribute("s2", s2);
        model.addAttribute("s3", s3);
        model.addAttribute("bet", bet);
        model.addAttribute("multiplier", multiplier);
        model.addAttribute("payout", payout);
        if (multiplier > 0) {
            model.addAttribute("result",
                    "当たり！ " + payout + " C 獲得！");
        } else {
            model.addAttribute("result",
                    "残念！今回はハズレです。");
        }
        return "slot";
    }
}
 
